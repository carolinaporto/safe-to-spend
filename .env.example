# Neon pooled connection string (use the -pooler host).
# Local dev via docker-compose: postgresql+psycopg://sts:sts@localhost:5432/safe_to_spend
# Tests use a SEPARATE database (name must end in _test); see conftest.py.
DATABASE_URL=

# bcrypt hash of the single-user password. Use a long, unique passphrase.
# Generate: python -m backend.scripts.hash_password "your-password"
APP_PASSWORD_HASH=

# Secret used to sign JWTs. Required — the app refuses to start without it.
# At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Shared secret required in the X-Cron-Secret header on /api/cron/* endpoints.
# Generate the same way as JWT_SECRET.
CRON_SECRET=

# Bump this to invalidate every issued JWT at once (e.g. after a suspected
# token leak). Any string; changing it logs everyone out.
TOKEN_VERSION=1

# Trust X-Forwarded-For / X-Real-IP. Set to "true" ONLY when a known proxy
# (Vercel) sits in front — it does. Off locally so a direct caller can't
# spoof its IP past the login throttle.
TRUST_PROXY_HEADERS=false

# Coarse in-memory per-IP rate limit on the API. Leave "true" in production.
RATE_LIMIT_ENABLED=true

# Base URL for the FX rate provider (Frankfurter / ECB).
FX_API_URL=https://api.frankfurter.dev

# Optional: enables receipt-text parsing. Feature degrades gracefully when absent.
ANTHROPIC_API_KEY=

# "true" on the public portfolio demo: destructive actions return 403 and the
# frontend hides the import screen. Leave false/blank for a real instance.
DEMO_MODE=false

# The deployed frontend origin (comma-separated if more than one).
# localhost dev origins are always allowed on top of this; nothing else is.
CORS_ORIGINS=

# Frontend: base URL of the API. Leave EMPTY in production so the app talks to
# its own origin (/api/*) — a cross-origin value would need the CSP widened.
VITE_API_BASE_URL=http://localhost:8000

# Not a config value — `backend.reset` and `backend.seed` refuse to run unless
# ALLOW_DESTRUCTIVE=1 is set in the environment AND you type the DB name.
