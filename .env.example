# Neon pooled connection string (use the -pooler host).
# Local dev via docker-compose: postgresql+psycopg://sts:sts@localhost:5432/safe_to_spend
DATABASE_URL=

# bcrypt hash of the single-user password.
# Generate: python -m backend.scripts.hash_password "your-password"
APP_PASSWORD_HASH=

# Secret used to sign JWTs.
JWT_SECRET=

# Shared secret required in the X-Cron-Secret header on /api/cron/* endpoints.
CRON_SECRET=

# Base URL for the FX rate provider (Frankfurter / ECB).
FX_API_URL=https://api.frankfurter.dev

# Optional: enables receipt-text parsing. Feature degrades gracefully when absent.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins (the deployed frontend origin).
CORS_ORIGINS=http://localhost:5173

# Frontend: base URL of the API.
VITE_API_BASE_URL=http://localhost:8000
